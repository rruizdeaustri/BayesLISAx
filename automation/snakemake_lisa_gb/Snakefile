import csv
from pathlib import Path

configfile: "config.yaml"

RESULTS = config["results_dir"]
LOGS = config["logs_dir"]

with open("bands.csv", newline="", encoding="utf-8") as fh:
    bands = [
        {
            "band_id": row["band_id"],
            "f_min": float(row["f_min"]),
            "f_max": float(row["f_max"]),
        }
        for row in csv.DictReader(fh)
    ]

BAND_IDS = [band["band_id"] for band in bands]
BAND_MAP = {band["band_id"]: band for band in bands}

STATIC = dict(config.get("static_ns", config.get("scan", {})))
HIGH = dict(config.get("highres", config.get("final", {})))
CAT = config.get("catalogue", {})
CONSENSUS = dict(config.get("consensus", {}))

HIGHRES_ENABLED = bool(HIGH.get("enabled", True))
CONSENSUS_ENABLED = HIGHRES_ENABLED and bool(
    CONSENSUS.get("enabled", True)
)

if config.get("workflow_mode", "production") == "dry_run":
    DRY = config.get("dry_run", {})
    STATIC.update(
        {
            key: value
            for key, value in DRY.items()
            if key
            in {
                "k_values",
                "seeds",
                "n_live",
                "num_inner_steps",
                "tol",
                "num_delete_ratio",
            }
        }
    )
    HIGH.update(
        {
            key: value
            for key, value in DRY.items()
            if key
            in {
                "seeds",
                "n_live",
                "num_inner_steps",
                "tol",
                "num_delete_ratio",
            }
        }
    )

K_VALUES = [
    str(k)
    for k in STATIC.get(
        "k_values",
        STATIC.get("kmax_values", [1]),
    )
]
SEEDS = [str(seed) for seed in STATIC.get("seeds", [0])]
HIGH_SEEDS = [str(seed) for seed in HIGH.get("seeds", [0])]

ALG = STATIC.get("algo", "ns")
if ALG != "ns":
    raise ValueError("static_ns.algo must be 'ns'")

if CONSENSUS_ENABLED and len(HIGH_SEEDS) < 2:
    raise ValueError(
        "Consensus requires at least two values in highres.seeds"
    )


def scan_json(window_id, k, seed):
    return (
        f"{RESULTS}/static_ns/scan/{window_id}/"
        f"k{k}/seed{seed}/summary.json"
    )


def high_json(window_id, seed):
    return (
        f"{RESULTS}/static_ns/highres/{window_id}/"
        f"seed{seed}/summary.json"
    )


def high_posterior(window_id, seed):
    return (
        f"{RESULTS}/static_ns/highres/{window_id}/"
        f"seed{seed}/posterior.npz"
    )


def selected_k(window_id):
    path = Path(f"{RESULTS}/static_ns/selected_k.csv")
    if not path.exists():
        return K_VALUES[0]

    with path.open(newline="", encoding="utf-8") as fh:
        for row in csv.DictReader(fh):
            if row["window_id"] == window_id:
                return row["K_best"]

    return K_VALUES[0]


ALL_INPUTS = [
    f"{RESULTS}/static_ns/all_runs.csv",
    f"{RESULTS}/static_ns/per_window_k_summary.csv",
    f"{RESULTS}/static_ns/selected_k.csv",
    f"{RESULTS}/static_ns/catalogue_summary.csv",
]

if HIGHRES_ENABLED:
    ALL_INPUTS.extend(
        [
            f"{RESULTS}/static_ns/selected_highres_runs.csv",
            f"{RESULTS}/static_ns/nearest_catalogue_matches.csv",
        ]
    )

if CONSENSUS_ENABLED:
    ALL_INPUTS.extend(
        expand(
            f"{RESULTS}/static_ns/consensus/"
            f"{{band_id}}/summary.json",
            band_id=BAND_IDS,
        )
    )


rule all:
    input:
        ALL_INPUTS


rule make_scan_config:
    output:
        f"{RESULTS}/static_ns/configs/{{band_id}}/k{{k}}.json"
    params:
        base=config["base_json"],
        f_min=lambda wc: BAND_MAP[wc.band_id]["f_min"],
        f_max=lambda wc: BAND_MAP[wc.band_id]["f_max"],
    shell:
        (
            "python scripts/make_band_config.py "
            "--base-json {params.base} "
            "--out-json {output} "
            "--f-min {params.f_min} "
            "--f-max {params.f_max} "
            "--kmax {wildcards.k}"
        )


rule run_static_scan:
    input:
        cfg=(
            f"{RESULTS}/static_ns/configs/"
            f"{{band_id}}/k{{k}}.json"
        )
    output:
        summary=(
            f"{RESULTS}/static_ns/scan/"
            f"{{band_id}}/k{{k}}/seed{{seed}}/summary.json"
        )
    params:
        repo=config["repo_root"],
        py=config["python"],
        pf=config["problem_factory"],
        n=STATIC.get("n_live", 500),
        tol=STATIC.get("tol", 2),
        nis=STATIC.get("num_inner_steps", 64),
        delr=STATIC.get("num_delete_ratio", 0.1),
        skip=(
            "--skip-plots"
            if STATIC.get("skip_plots", True)
            else ""
        ),
        f_min=lambda wc: BAND_MAP[wc.band_id]["f_min"],
        f_max=lambda wc: BAND_MAP[wc.band_id]["f_max"],
    shell:
        r"""
        python scripts/run_benchmark.py \
          --python {params.py} \
          --repo-root {params.repo} \
          --problem-factory {params.pf} \
          --config-json {input.cfg} \
          --algo ns \
          --seed {wildcards.seed} \
          --n-live {params.n} \
          --tol {params.tol} \
          --num-inner-steps {params.nis} \
          --num-delete-ratio {params.delr} \
          --initial-num-steps 16 \
          --refinement-num-steps 8 \
          --max-batches 8 \
          {params.skip} \
          --out-json {output.summary}

        python - <<'EOF'
import json
from pathlib import Path

path = Path("{output.summary}")
data = json.loads(path.read_text())
data["metadata"] = {{
    "window_id": "{wildcards.band_id}",
    "f_min": {params.f_min},
    "f_max": {params.f_max},
    "K": int("{wildcards.k}"),
    "num_delete_ratio": {params.delr},
    "phase": "scan",
}}
path.write_text(json.dumps(data, indent=2))
EOF
        """


rule aggregate_static_ns:
    input:
        expand(
            f"{RESULTS}/static_ns/scan/"
            f"{{band_id}}/k{{k}}/seed{{seed}}/summary.json",
            band_id=BAND_IDS,
            k=K_VALUES,
            seed=SEEDS,
        )
    output:
        all=f"{RESULTS}/static_ns/all_runs.csv",
        ksum=f"{RESULTS}/static_ns/per_window_k_summary.csv",
        selected=f"{RESULTS}/static_ns/selected_k.csv",
    shell:
        (
            "python scripts/static_ns_tables.py "
            "--inputs {input} "
            "--out-all {output.all} "
            "--out-k-summary {output.ksum} "
            "--out-selected {output.selected}"
        )


rule make_highres_config:
    input:
        f"{RESULTS}/static_ns/selected_k.csv"
    output:
        f"{RESULTS}/static_ns/highres/{{band_id}}/config.json"
    params:
        base=config["base_json"],
        f_min=lambda wc: BAND_MAP[wc.band_id]["f_min"],
        f_max=lambda wc: BAND_MAP[wc.band_id]["f_max"],
    shell:
        (
            "python scripts/make_band_config.py "
            "--base-json {params.base} "
            "--out-json {output} "
            "--f-min {params.f_min} "
            "--f-max {params.f_max} "
            "--kmax $(python -c "
            "\"import csv; "
            "print(next(row['K_best'] "
            "for row in csv.DictReader(open('{input}')) "
            "if row['window_id'] == "
            "'{wildcards.band_id}'))\")"
        )


rule run_highres:
    input:
        cfg=(
            f"{RESULTS}/static_ns/highres/"
            f"{{band_id}}/config.json"
        )
    output:
        summary=(
            f"{RESULTS}/static_ns/highres/"
            f"{{band_id}}/seed{{seed}}/summary.json"
        ),
        posterior=(
            f"{RESULTS}/static_ns/highres/"
            f"{{band_id}}/seed{{seed}}/posterior.npz"
        ),
    params:
        repo=config["repo_root"],
        py=config["python"],
        pf=config["problem_factory"],
        n=HIGH.get("n_live", 1000),
        tol=HIGH.get("tol", 1),
        nis=HIGH.get("num_inner_steps", 96),
        delr=HIGH.get("num_delete_ratio", 0.1),
        skip=(
            "--skip-plots"
            if HIGH.get("skip_plots", True)
            else ""
        ),
        f_min=lambda wc: BAND_MAP[wc.band_id]["f_min"],
        f_max=lambda wc: BAND_MAP[wc.band_id]["f_max"],
    shell:
        r"""
        export JAX_SAMPLERS_POSTERIOR_PATH="{output.posterior}"
        export JAX_SAMPLERS_POSTERIOR_SEED="{wildcards.seed}"
        export JAX_SAMPLERS_POSTERIOR_ALGO="ns"
        export JAX_SAMPLERS_CONFIG="{input.cfg}"

        python scripts/run_benchmark.py \
          --python {params.py} \
          --repo-root {params.repo} \
          --problem-factory {params.pf} \
          --config-json {input.cfg} \
          --algo ns \
          --seed {wildcards.seed} \
          --n-live {params.n} \
          --tol {params.tol} \
          --num-inner-steps {params.nis} \
          --num-delete-ratio {params.delr} \
          --initial-num-steps 16 \
          --refinement-num-steps 8 \
          --max-batches 8 \
          {params.skip} \
          --out-json {output.summary}

        test -s "{output.posterior}" || {{
          echo "ERROR: posterior bundle was not created: {output.posterior}" >&2
          exit 1
        }}

        python - <<'EOF'
import csv
import json
from pathlib import Path

with open(
    "{RESULTS}/static_ns/selected_k.csv",
    newline="",
    encoding="utf-8",
) as fh:
    k = next(
        row["K_best"]
        for row in csv.DictReader(fh)
        if row["window_id"] == "{wildcards.band_id}"
    )

path = Path("{output.summary}")
data = json.loads(path.read_text())
data["metadata"] = {{
    "window_id": "{wildcards.band_id}",
    "f_min": {params.f_min},
    "f_max": {params.f_max},
    "K": int(k),
    "num_delete_ratio": {params.delr},
    "phase": "highres",
    "posterior_path": "{output.posterior}",
}}
path.write_text(json.dumps(data, indent=2))
EOF
        """


rule aggregate_highres:
    input:
        scan=expand(
            f"{RESULTS}/static_ns/scan/"
            f"{{band_id}}/k{{k}}/seed{{seed}}/summary.json",
            band_id=BAND_IDS,
            k=K_VALUES,
            seed=SEEDS,
        ),
        high=expand(
            f"{RESULTS}/static_ns/highres/"
            f"{{band_id}}/seed{{seed}}/summary.json",
            band_id=BAND_IDS,
            seed=HIGH_SEEDS,
        ),
    output:
        f"{RESULTS}/static_ns/selected_highres_runs.csv"
    shell:
        (
            "python scripts/static_ns_tables.py "
            "--inputs {input.scan} "
            "--highres-inputs {input.high} "
            f"--out-all {RESULTS}/static_ns/all_runs.csv "
            f"--out-k-summary "
            f"{RESULTS}/static_ns/per_window_k_summary.csv "
            f"--out-selected {RESULTS}/static_ns/selected_k.csv "
            "--out-highres {output}"
        )


rule within_window_consensus:
    input:
        posteriors=lambda wc: [
            high_posterior(wc.band_id, seed)
            for seed in HIGH_SEEDS
        ]
    output:
        clusters=(
            f"{RESULTS}/static_ns/consensus/"
            f"{{band_id}}/clusters.csv"
        ),
        cooccurrence=(
            f"{RESULTS}/static_ns/consensus/"
            f"{{band_id}}/cooccurrence.csv"
        ),
        modes=(
            f"{RESULTS}/static_ns/consensus/"
            f"{{band_id}}/modes.json"
        ),
        summary=(
            f"{RESULTS}/static_ns/consensus/"
            f"{{band_id}}/summary.json"
        ),
    params:
        py=config["python"],
        tobs=config.get("sangria", {}).get(
            "tobs",
            31457280.0,
        ),
        dim_per=CONSENSUS.get("dim_per", 6),
        f0_index=CONSENSUS.get("f0_index", 0),
        p_index=CONSENSUS.get("p_index", 6),
        p_active_min=CONSENSUS.get("p_active_min", 0.5),
        cluster_eps_bins=CONSENSUS.get(
            "cluster_eps_bins",
            5.0,
        ),
        max_span_factor=CONSENSUS.get(
            "max_span_factor",
            10.0,
        ),
        seed_inclusion_threshold=CONSENSUS.get(
            "seed_inclusion_threshold",
            0.1,
        ),
        min_mean_inclusion=CONSENSUS.get(
            "min_mean_inclusion",
            0.05,
        ),
        robust_seed_fraction=CONSENSUS.get(
            "robust_seed_fraction",
            0.8,
        ),
        robust_inclusion=CONSENSUS.get(
            "robust_inclusion",
            0.5,
        ),
        robust_max_between_bins=CONSENSUS.get(
            "robust_max_between_bins",
            5.0,
        ),
        plausible_seed_fraction=CONSENSUS.get(
            "plausible_seed_fraction",
            0.5,
        ),
        plausible_inclusion=CONSENSUS.get(
            "plausible_inclusion",
            0.1,
        ),
        exclusive_overlap_ratio=CONSENSUS.get(
            "exclusive_overlap_ratio",
            0.2,
        ),
    shell:
        r"""
        {params.py} scripts/within_window_consensus.py \
          --inputs {input.posteriors} \
          --window-id {wildcards.band_id} \
          --tobs {params.tobs} \
          --dim-per {params.dim_per} \
          --f0-index {params.f0_index} \
          --p-index {params.p_index} \
          --p-active-min {params.p_active_min} \
          --cluster-eps-bins {params.cluster_eps_bins} \
          --max-span-factor {params.max_span_factor} \
          --seed-inclusion-threshold {params.seed_inclusion_threshold} \
          --min-mean-inclusion {params.min_mean_inclusion} \
          --robust-seed-fraction {params.robust_seed_fraction} \
          --robust-inclusion {params.robust_inclusion} \
          --robust-max-between-bins {params.robust_max_between_bins} \
          --plausible-seed-fraction {params.plausible_seed_fraction} \
          --plausible-inclusion {params.plausible_inclusion} \
          --exclusive-overlap-ratio {params.exclusive_overlap_ratio} \
          --out-clusters {output.clusters} \
          --out-cooccurrence {output.cooccurrence} \
          --out-modes {output.modes} \
          --out-summary {output.summary}
        """


CATALOGUE_INPUTS = [
    f"{RESULTS}/static_ns/selected_k.csv"
]

if HIGHRES_ENABLED:
    CATALOGUE_INPUTS.append(
        f"{RESULTS}/static_ns/selected_highres_runs.csv"
    )

MATCH_ARGS = (
    f"--highres-csv "
    f"{RESULTS}/static_ns/selected_highres_runs.csv"
    if HIGHRES_ENABLED
    else ""
)


rule catalogue_diagnostics:
    input:
        CATALOGUE_INPUTS
    output:
        summary=f"{RESULTS}/static_ns/catalogue_summary.csv",
        matches=(
            f"{RESULTS}/static_ns/"
            f"nearest_catalogue_matches.csv"
        ),
    params:
        h5=config.get("sangria", {}).get("h5_path", ""),
        tobs=config.get("sangria", {}).get(
            "tobs",
            31457280.0,
        ),
        margin=CAT.get("margin_hz", 5e-6),
        th=" ".join(
            str(value)
            for value in CAT.get(
                "snr_thresholds",
                [0.5, 1, 2, 3, 4, 5, 7, 10],
            )
        ),
        top=CAT.get("top_n", 40),
        match_args=MATCH_ARGS,
    shell:
        r"""
        if test -n "{params.h5}"; then
          python scripts/catalogue_window_diagnostics.py \
            --h5-path {params.h5} \
            --selected-csv {input[0]} \
            {params.match_args} \
            --tobs {params.tobs} \
            --margin-hz {params.margin} \
            --match-radius-bins 5 \
            --snr-thresholds {params.th} \
            --top-n {params.top} \
            --out-summary {output.summary} \
            --out-matches {output.matches}
        else
          mkdir -p "$(dirname {output.summary})"
          echo 'window_id,f_min,f_max,catalogue_f_min,catalogue_f_max,total_catalogue_sources,top_sources_json' > {output.summary}
          echo 'window_id,recovered_f0,catalogue_frequency,delta_f,approx_snr,source_type' > {output.matches}
        fi
        """
