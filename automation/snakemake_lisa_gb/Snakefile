import csv
import json
from pathlib import Path

configfile: "config.yaml"

RESULTS = config["results_dir"]
LOGS = config["logs_dir"]

bands = []
with open("bands.csv", "r", encoding="utf-8") as fh:
    reader = csv.DictReader(fh)
    for row in reader:
        bands.append(
            {
                "band_id": row["band_id"],
                "f_min": float(row["f_min"]),
                "f_max": float(row["f_max"]),
            }
        )

BAND_IDS = [b["band_id"] for b in bands]
BAND_MAP = {b["band_id"]: b for b in bands}

SCAN_KS = [str(k) for k in config["scan"]["kmax_values"]]
SCAN_SEEDS = [str(s) for s in config["scan"]["seeds"]]
FINAL_SEEDS = [str(s) for s in config["final"]["seeds"]]

BENCH = config.get("benchmark", {})
BENCH_ENABLED = bool(BENCH.get("enabled", False))
BENCH_PRESETS = BENCH.get("presets", {})
BENCH_PRESET_NAME = str(BENCH.get("preset", "smoke"))
BENCH_PRESET = BENCH_PRESETS.get(BENCH_PRESET_NAME, {})

def _bench_list(key, fallback=None):
    explicit = BENCH.get(key, None)
    if explicit not in (None, []):
        return [str(x) for x in explicit]
    preset_vals = BENCH_PRESET.get(key, fallback if fallback is not None else [])
    return [str(x) for x in preset_vals]

BENCH_ALGOS = _bench_list("algos")
BENCH_SEEDS = _bench_list("seeds")
BENCH_NLIVE = _bench_list("n_live")
BENCH_TOL = _bench_list("tol")
BENCH_NIS = _bench_list("num_inner_steps")
BENCH_GSTEP = _bench_list("ggns_step_size", [0.001])
BENCH_GNIS = _bench_list("ggns_num_inner_steps", [1])
BENCH_INIT = _bench_list("initial_num_steps", [16])
BENCH_REFIN = _bench_list("refinement_num_steps", [8])
BENCH_BATCH = _bench_list("max_batches", [8])


rule all:
    input:
        expand(f"{RESULTS}/final/{{band_id}}/done.txt", band_id=BAND_IDS)


rule make_scan_config:
    output:
        f"{RESULTS}/scan/{{band_id}}/k{{kmax}}/config.json"
    params:
        base_json=config["base_json"],
        f_min=lambda wc: BAND_MAP[wc.band_id]["f_min"],
        f_max=lambda wc: BAND_MAP[wc.band_id]["f_max"],
    shell:
        r"""
        python scripts/make_band_config.py \
          --base-json {params.base_json} \
          --out-json {output} \
          --f-min {params.f_min} \
          --f-max {params.f_max} \
          --kmax {wildcards.kmax}
        """

rule run_scan_ns:
    input:
        cfg=f"{RESULTS}/scan/{{band_id}}/k{{kmax}}/config.json"
    output:
        log=f"{LOGS}/scan/{{band_id}}_k{{kmax}}_s{{seed}}.log"
    params:
        repo=config["repo_root"],
        py=config["python"],
        problem_factory=config["problem_factory"],
        n_live=config["scan"]["n_live"],
        tol=config["scan"]["tol"],
        nis=config["scan"]["num_inner_steps"],
        skip_plots=("--skip-plots" if config["scan"].get("skip_plots", False) else "")
    shell:
        r"""
        set -euo pipefail
        mkdir -p $(dirname {output.log})
        export JAX_SAMPLERS_CONFIG=$(realpath {input.cfg})
        PYTHONPATH={params.repo}/src:$PYTHONPATH \
        {params.py} -m jax_samplers.cli \
          --algo ns \
          --problem factory \
          --problem-factory {params.problem_factory} \
          --n-live {params.n_live} \
          --tol {params.tol} \
          --num-inner-steps {params.nis} \
          {params.skip_plots} \
          --seed {wildcards.seed} \
          > {output.log} 2>&1
        """

rule summarize_scan:
    input:
        lambda wc: [f"{LOGS}/scan/{wc.band_id}_k{k}_s{SCAN_SEEDS[0]}.log" for k in SCAN_KS]
    output:
        f"{RESULTS}/scan/{{band_id}}/summary.csv"
    params:
        kmaxs=" ".join(SCAN_KS)
    shell:
        r"""
        python scripts/summarize.py \
          --logs {input} \
          --kmaxs {params.kmaxs} \
          --out-csv {output}
        """


rule select_kmax:
    input:
        f"{RESULTS}/scan/{{band_id}}/summary.csv"
    output:
        f"{RESULTS}/scan/{{band_id}}/selection.json"
    params:
        delta=config.get("selection_delta_logz", 1.0)
    shell:
        r"""
        python scripts/select_kmax.py \
          --summary-csv {input} \
          --out-json {output} \
          --delta-logz {params.delta}
        """


rule make_final_config:
    input:
        sel=f"{RESULTS}/scan/{{band_id}}/selection.json"
    output:
        f"{RESULTS}/final/{{band_id}}/config.json"
    params:
        base_json=config["base_json"],
        f_min=lambda wc: BAND_MAP[wc.band_id]["f_min"],
        f_max=lambda wc: BAND_MAP[wc.band_id]["f_max"],
    run:
        selection = json.loads(Path(input.sel).read_text(encoding="utf-8"))
        kmax = int(selection["selected_kmax"])
        shell(
            "python scripts/make_band_config.py "
            "--base-json {params.base_json} "
            "--out-json {output} "
            "--f-min {params.f_min} "
            "--f-max {params.f_max} "
            f"--kmax {kmax}"
        )

rule run_final_ns:
    input:
        cfg=f"{RESULTS}/final/{{band_id}}/config.json"
    output:
        log=f"{LOGS}/final/{{band_id}}_s{{seed}}.log"
    params:
        repo=config["repo_root"],
        py=config["python"],
        problem_factory=config["problem_factory"],
        n_live=config["final"]["n_live"],
        tol=config["final"]["tol"],
        nis=config["final"]["num_inner_steps"],
        skip_plots=("--skip-plots" if config["final"].get("skip_plots", False) else ""),
        no_show=("--no-show" if config["final"].get("no_show", False) else ""),
        save_arg=(f'--save {config["final"]["save_plot"]}' if config["final"].get("save_plot", "") else "")
    shell:
        r"""
        set -euo pipefail
        mkdir -p $(dirname {output.log})
        export JAX_SAMPLERS_CONFIG=$(realpath {input.cfg})
        PYTHONPATH={params.repo}/src:$PYTHONPATH \
        {params.py} -m jax_samplers.cli \
          --algo ns \
          --problem factory \
          --problem-factory {params.problem_factory} \
          --n-live {params.n_live} \
          --tol {params.tol} \
          --num-inner-steps {params.nis} \
          {params.skip_plots} \
          {params.no_show} \
          {params.save_arg} \
          --seed {wildcards.seed} \
          > {output.log} 2>&1
        """

rule mark_done:
    input:
        lambda wc: [f"{LOGS}/final/{wc.band_id}_s{s}.log" for s in FINAL_SEEDS]
    output:
        f"{RESULTS}/final/{{band_id}}/done.txt"
    shell:
        "echo done > {output}"


if BENCH_ENABLED:
    rule benchmark_all:
        input:
            expand(
                f"{RESULTS}/bench/{{band_id}}/algo={{algo}}/seed={{seed}}/nlive={{n_live}}/tol={{tol}}/nis={{num_inner_steps}}/gstep={{ggns_step_size}}/gnis={{ggns_num_inner_steps}}/init={{initial_num_steps}}/ref={{refinement_num_steps}}/batches={{max_batches}}/summary.json",
                band_id=BAND_IDS,
                algo=BENCH_ALGOS,
                seed=BENCH_SEEDS,
                n_live=BENCH_NLIVE,
                tol=BENCH_TOL,
                num_inner_steps=BENCH_NIS,
                ggns_step_size=BENCH_GSTEP,
                ggns_num_inner_steps=BENCH_GNIS,
                initial_num_steps=BENCH_INIT,
                refinement_num_steps=BENCH_REFIN,
                max_batches=BENCH_BATCH,
            ),
            f"{RESULTS}/bench/summary_table.csv"

    rule run_benchmark_case:
        input:
            cfg=f"{RESULTS}/final/{{band_id}}/config.json"
        output:
            summary=f"{RESULTS}/bench/{{band_id}}/algo={{algo}}/seed={{seed}}/nlive={{n_live}}/tol={{tol}}/nis={{num_inner_steps}}/gstep={{ggns_step_size}}/gnis={{ggns_num_inner_steps}}/init={{initial_num_steps}}/ref={{refinement_num_steps}}/batches={{max_batches}}/summary.json"
        params:
            repo=config["repo_root"], py=config["python"],
            problem_factory=config["problem_factory"],
            skip_plots=("--skip-plots" if BENCH.get("skip_plots", True) else ""),
            ess_min=BENCH.get("ess_min", 0),
            bad_logz_min=BENCH.get("bad_logz_min", -1.0e99),
            local_mode_f0_sigma_max=BENCH.get("local_mode_f0_sigma_max", 1.0e-7),
            benchmark_preset=BENCH_PRESET_NAME
        shell:
            r"""
            python scripts/run_benchmark.py \
              --python {params.py} \
              --repo-root {params.repo} \
              --problem-factory {params.problem_factory} \
              --config-json {input.cfg} \
              --algo {wildcards.algo} \
              --seed {wildcards.seed} \
              --n-live {wildcards.n_live} \
              --tol {wildcards.tol} \
              --num-inner-steps {wildcards.num_inner_steps} \
              --ggns-step-size {wildcards.ggns_step_size} \
              --ggns-num-inner-steps {wildcards.ggns_num_inner_steps} \
              --initial-num-steps {wildcards.initial_num_steps} \
              --refinement-num-steps {wildcards.refinement_num_steps} \
              --max-batches {wildcards.max_batches} \
              --ess-min={params.ess_min} \
              --bad-logz-min={params.bad_logz_min} \
              --local-mode-f0-sigma-max={params.local_mode_f0_sigma_max} \
              --benchmark-preset {params.benchmark_preset} \
              {params.skip_plots} \
              --out-json {output.summary}
            """

    rule aggregate_benchmarks:
        input:
            expand(
                f"{RESULTS}/bench/{{band_id}}/algo={{algo}}/seed={{seed}}/nlive={{n_live}}/tol={{tol}}/nis={{num_inner_steps}}/gstep={{ggns_step_size}}/gnis={{ggns_num_inner_steps}}/init={{initial_num_steps}}/ref={{refinement_num_steps}}/batches={{max_batches}}/summary.json",
                band_id=BAND_IDS, algo=BENCH_ALGOS, seed=BENCH_SEEDS,
                n_live=BENCH_NLIVE, tol=BENCH_TOL, num_inner_steps=BENCH_NIS,
                ggns_step_size=BENCH_GSTEP, ggns_num_inner_steps=BENCH_GNIS,
                initial_num_steps=BENCH_INIT, refinement_num_steps=BENCH_REFIN,
                max_batches=BENCH_BATCH,
            )
        output:
            f"{RESULTS}/bench/summary_table.csv"
        shell:
            "python scripts/aggregate_benchmarks.py --inputs {input} --out-csv {output}"
